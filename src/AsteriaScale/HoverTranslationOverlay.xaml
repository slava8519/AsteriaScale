<Window x:Class="AsteriaScale.HoverTranslationOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="292" SizeToContent="Height" MinWidth="248" MaxWidth="430" MaxHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" IsHitTestVisible="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Border x:Name="Card" Background="#F40A0F1D" BorderBrush="#765CFF"
            BorderThickness="1" CornerRadius="12" Padding="10,9,10,9"
            ClipToBounds="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.52" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#45DDC8"
                             Margin="0,0,7,0" />
                    <TextBlock x:Name="ModeText" Text="Словарь" FontSize="10.5"
                               FontWeight="SemiBold" Foreground="#D6DAEA"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border x:Name="MetaBadge" Grid.Column="1" Background="#142A2B"
                        BorderBrush="#315B59" BorderThickness="1" CornerRadius="7"
                        Padding="7,2.5" Margin="10,0,0,0">
                    <TextBlock x:Name="MetaText" Text="EN → RU  ·  СЛОВО"
                               Foreground="#59DDCC" FontSize="8.5"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>

            <TextBlock x:Name="SourceText" Grid.Row="1" Margin="0,6,0,0"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       Foreground="#EEF1FB" FontSize="14" FontWeight="SemiBold"
                       LineHeight="19" MaxHeight="57" />

            <Grid Grid.Row="2" Margin="0,6,0,0">
                <StackPanel x:Name="MeaningsPanel" Visibility="Collapsed">
                    <ItemsControl x:Name="MeaningsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#182036" CornerRadius="6"
                                        BorderBrush="#293452" BorderThickness="1"
                                        Padding="6,3" Margin="0,0,4,4">
                                    <TextBlock Text="{Binding}" Foreground="#F4F6FF"
                                               FontSize="12" FontWeight="Medium"
                                               TextWrapping="Wrap" MaxWidth="300" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="MoreMeaningsText" Visibility="Collapsed"
                               Margin="1,0,0,0" Foreground="#8F99B3"
                               FontSize="9.5" />
                </StackPanel>

                <StackPanel x:Name="TranslationPanel">
                    <TextBlock x:Name="TranslationText" Text="Ищу перевод…"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Foreground="#F5F7FF" FontSize="14.5" FontWeight="SemiBold"
                               LineHeight="20" MaxHeight="140" />
                    <TextBlock x:Name="HintText" Margin="0,5,0,0" Visibility="Collapsed"
                               TextWrapping="Wrap" Foreground="#8F99B3" FontSize="9.5"
                               LineHeight="14" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
