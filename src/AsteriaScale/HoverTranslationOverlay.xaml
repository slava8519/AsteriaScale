<Window x:Class="AsteriaScale.HoverTranslationOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="292" SizeToContent="Height" MinWidth="248" MaxWidth="430" MaxHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" IsHitTestVisible="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <!-- Light "sandy" hover card. Per-mode accent/border/badge brushes and a couple of
         text foregrounds are assigned in HoverTranslationOverlay.xaml.cs — see the
         "Карточка перевода" section of HANDOFF.md for the exact C# swaps. -->
    <Border x:Name="Card" Background="#F7F7F2E8" BorderBrush="#9DBE93"
            BorderThickness="1" CornerRadius="12" Padding="10,9,10,9"
            ClipToBounds="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.4" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#5F7A54" Margin="0,0,7,0" />
                    <TextBlock x:Name="ModeText" Text="Словарь" FontSize="10.5"
                               FontWeight="SemiBold" Foreground="#4A4436"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>

                <Border x:Name="MetaBadge" Grid.Column="1" Background="#E7EFE1"
                        BorderBrush="#9DBE93" BorderThickness="1" CornerRadius="7"
                        Padding="7,2.5" Margin="10,0,0,0">
                    <TextBlock x:Name="MetaText" Text="EN → RU  ·  СЛОВО"
                               Foreground="#4E6E44" FontSize="8.5"
                               FontWeight="SemiBold" TextWrapping="NoWrap" />
                </Border>
            </Grid>

            <TextBlock x:Name="SourceText" Grid.Row="1" Margin="0,6,0,0"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       Foreground="#35302A" FontSize="14" FontWeight="SemiBold"
                       LineHeight="19" MaxHeight="57" />

            <Grid Grid.Row="2" Margin="0,6,0,0">
                <StackPanel x:Name="MeaningsPanel" Visibility="Collapsed">
                    <ItemsControl x:Name="MeaningsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#EFE8DA" CornerRadius="6"
                                        BorderBrush="#E1D7C4" BorderThickness="1"
                                        Padding="6,3" Margin="0,0,4,4">
                                    <TextBlock Text="{Binding}" Foreground="#35302A"
                                               FontSize="12" FontWeight="Medium"
                                               TextWrapping="Wrap" MaxWidth="300" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="MoreMeaningsText" Visibility="Collapsed"
                               Margin="1,0,0,0" Foreground="#A0967F" FontSize="9.5" />
                </StackPanel>

                <StackPanel x:Name="TranslationPanel">
                    <TextBlock x:Name="TranslationText" Text="Ищу перевод…"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Foreground="#2E2A22" FontSize="14.5" FontWeight="SemiBold"
                               LineHeight="20" MaxHeight="140" />
                    <TextBlock x:Name="HintText" Margin="0,5,0,0" Visibility="Collapsed"
                               TextWrapping="Wrap" Foreground="#A0967F" FontSize="9.5"
                               LineHeight="14" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
