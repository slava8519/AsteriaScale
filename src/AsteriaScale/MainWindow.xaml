<Window x:Class="AsteriaScale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Asteria Scale"
        Width="1080" Height="760" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Closing="OnWindowClosing"
        StateChanged="OnWindowStateChanged">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="54" Height="54" CornerRadius="16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#9A7BFF" Offset="0" />
                        <GradientStop Color="#5B3FD6" Offset="0.55" />
                        <GradientStop Color="#1ED7C3" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="A" FontSize="27" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="Asteria Scale" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="Апскейл приложений и visual novel в реальном времени"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#182A35" BorderBrush="#245B58" BorderThickness="1"
                        CornerRadius="10" Padding="11,7" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource MintBrush}" Margin="0,0,7,0" />
                        <TextBlock x:Name="EngineStatusText" Text="Проверка движка…" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="11,7">
                    <TextBlock x:Name="HardwareSummaryText" Text="Определение GPU…" FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="1  Выберите окно" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Окно должно быть открыто и не свёрнуто"
                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,6"
                                ToolTip="Обновить список" Click="OnRefreshWindowsClick">
                            <TextBlock Text="↻" FontSize="18" />
                        </Button>
                    </Grid>

                    <TextBox x:Name="WindowSearchBox" Grid.Row="2" Height="36"
                             ToolTip="Поиск по заголовку или процессу"
                             TextChanged="OnWindowSearchChanged" />

                    <ListBox x:Name="WindowsList" Grid.Row="4"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnWindowSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemRoot" Background="{TemplateBinding Background}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="10" Padding="11,9">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemRoot" Property="Background" Value="#19243B" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemRoot" Property="Background" Value="#25214A" />
                                                    <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="WindowsEmptyText" Grid.Row="4" Text="Подходящие окна не найдены"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />

                    <Button x:Name="AddProfileButton" Grid.Row="6" Content="Добавить в автоматизацию"
                            IsEnabled="False" Click="OnAddProfileClick" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="2  Качество масштабирования" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Ручной запуск и начальный режим для нового автопрофиля"
                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,14" />

                            <ComboBox x:Name="PresetComboBox" Height="40"
                                      SelectionChanged="OnPresetSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Частота обработки VN:" VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="VisualNovelFrameRateComboBox" Grid.Column="2" Height="36"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="OnVisualNovelFrameRateChanged" />
                            </Grid>

                            <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="11"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="13" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="PresetDescriptionText" TextWrapping="Wrap" FontSize="13" />
                                    <TextBlock x:Name="PresetPerformanceText" TextWrapping="Wrap"
                                               Foreground="{StaticResource MintBrush}" FontSize="11"
                                               Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ScaleButton" Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Запустить на весь экран" Click="OnScaleClick" />
                                <Button Grid.Column="2" Content="В окне" Padding="18,12"
                                        Click="OnWindowedScaleClick" />
                            </Grid>

                            <TextBlock Text="Alt + Shift + A — включить/выключить  •  Alt + Shift + Q — оконный режим"
                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="3  Автономная работа" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Для каждой программы можно выбрать свой режим масштабирования"
                                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="AutomationCheckBox" HorizontalAlignment="Right"
                                          VerticalAlignment="Top" Content="Включена"
                                          Checked="OnAutomationChanged" Unchecked="OnAutomationChanged" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="RunAtStartupCheckBox" Content="Запускать с Windows"
                                          Checked="OnRunAtStartupChanged" Unchecked="OnRunAtStartupChanged" />
                                <CheckBox x:Name="StartMinimizedCheckBox" Grid.Column="2" Content="Сразу сворачивать в трей"
                                          Checked="OnStartMinimizedChanged" Unchecked="OnStartMinimizedChanged" />
                            </Grid>

                            <Grid Grid.Row="4">
                                <ListBox x:Name="ProfilesList" MaxHeight="180" MinHeight="58"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="210" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Details}" FontSize="11"
                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="2" Height="34"
                                                          ToolTip="Режим масштабирования для этой программы"
                                                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=AvailablePresets}"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding PresetId, Mode=OneWay}"
                                                          SelectionChanged="OnProfilePresetSelectionChanged" />
                                                <CheckBox Grid.Column="4" Content="Hook" VerticalAlignment="Center"
                                                          ToolTip="Брать текст этой игры из Textractor (при включённом text-hook)"
                                                          IsChecked="{Binding TextHookEnabled, Mode=TwoWay}"
                                                          Checked="OnProfileTextHookChanged"
                                                          Unchecked="OnProfileTextHookChanged" />
                                                <Button Grid.Column="6" Content="Удалить" Padding="11,7"
                                                        VerticalAlignment="Center" Tag="{Binding}"
                                                        Click="OnRemoveProfileClick" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel Margin="0,0,145,0">
                                    <TextBlock Text="4  Перевод текста" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TranslationDescriptionText"
                                               Text="Задержите мышь над словом или репликой — перевод появится рядом"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                    <Button Content="Мой словарь" Padding="12,6" Margin="0,0,12,0"
                                            ToolTip="Личные записи, история переводов и экспорт в Anki"
                                            Click="OnOpenUserDictionaryClick" />
                                    <CheckBox x:Name="HoverTranslationCheckBox"
                                              VerticalAlignment="Center" Content="Включён"
                                              Checked="OnHoverTranslationChanged" Unchecked="OnHoverTranslationChanged" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Режим:" VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="TranslationModeComboBox" Grid.Column="2" Height="36"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="OnTranslationModeChanged" />
                            </Grid>

                            <Grid x:Name="HoverDelayPanel" Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Задержка:" VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="HoverDelayComboBox" Grid.Column="2" Height="36"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="OnHoverDelayChanged" />
                            </Grid>

                            <Border x:Name="ScreenTranslationHint" Grid.Row="4" Visibility="Collapsed"
                                    Background="#111D28" BorderBrush="#285A61" BorderThickness="1"
                                    CornerRadius="10" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#213A38" BorderBrush="#34786F" BorderThickness="1"
                                            CornerRadius="7" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="Alt + Shift + T" Foreground="{StaticResource MintBrush}"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="Распознать все реплики и заменить их переводом. Повторное нажатие обновляет подложки."
                                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                </Grid>
                            </Border>

                            <Border x:Name="SmartDictionarySettingsPanel" Grid.Row="6"
                                    Visibility="Collapsed"
                                    Background="#111A2C" BorderBrush="#2A3A61" BorderThickness="1"
                                    CornerRadius="10" Padding="13,11">
                                <StackPanel>
                                    <TextBlock Text="Настройки умного словаря"
                                               FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Модель используется только для выбора подходящего словарного значения."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="11" Margin="0,3,0,10" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="280" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Ускоритель" FontWeight="SemiBold" />
                                            <TextBlock Text="Авто выбирает рекомендуемый CPU"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="10" />
                                        </StackPanel>
                                        <ComboBox x:Name="SmartBackendComboBox" Grid.Column="2" Height="34"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="OnSmartDictionarySettingChanged" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="280" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Язык оригинала" FontWeight="SemiBold" />
                                            <TextBlock Text="Фиксированный язык сокращает работу модели"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="10" />
                                        </StackPanel>
                                        <ComboBox x:Name="SmartSourceLanguageComboBox" Grid.Column="2" Height="34"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="OnSmartDictionarySettingChanged" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="280" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Если перевода нет" FontWeight="SemiBold" />
                                            <TextBlock Text="Ручной fallback: Alt+Shift+D после наведения"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="10" />
                                        </StackPanel>
                                        <ComboBox x:Name="SmartFallbackComboBox" Grid.Column="2" Height="34"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="OnSmartDictionarySettingChanged" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="280" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Готовность модели" FontWeight="SemiBold" />
                                            <TextBlock Text="Быстрый ответ или меньше занятой памяти"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="10" />
                                        </StackPanel>
                                        <ComboBox x:Name="SmartMemoryPolicyComboBox" Grid.Column="2" Height="34"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="OnSmartDictionarySettingChanged" />
                                    </Grid>

                                    <TextBlock x:Name="SmartDictionarySettingsHint"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MintBrush}"
                                               FontSize="10" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <CheckBox x:Name="TextHookCheckBox" Content="Text-hook (Textractor)"
                                              FontWeight="SemiBold"
                                              Checked="OnTextHookChanged" Unchecked="OnTextHookChanged" />
                                    <TextBlock Text="Текст совместимых игр — напрямую из процесса; иначе всегда OCR"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBox x:Name="TextractorPathBox" Grid.Column="2" Height="34"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Папка Textractor (содержит x86/x64 TextractorCLI.exe)"
                                         LostFocus="OnTextractorPathChanged" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Background="#111D28" BorderBrush="#244B56" BorderThickness="1"
                            CornerRadius="12" Padding="14" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NPU" Foreground="{StaticResource MintBrush}" FontWeight="Bold"
                                       VerticalAlignment="Top" />
                            <TextBlock x:Name="NpuExplanationText" Grid.Column="2" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                                       Text="Проверка NPU…" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="8" Height="8" Fill="{StaticResource MintBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="2" Text="Готово"
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="3" Content="Открыть настройки движка" Padding="10,5"
                    FontSize="11" Click="OnOpenEngineClick" />
        </Grid>
    </Grid>
</Window>
