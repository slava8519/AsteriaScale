<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AsteriaScale.RankerWorker</AssemblyName>
    <RootNamespace>AsteriaScale.RankerWorker</RootNamespace>
    <Version>1.0.0</Version>
    <IncludeExperimentalConsecModel Condition="'$(IncludeExperimentalConsecModel)' == ''">false</IncludeExperimentalConsecModel>
    <ConsecBundleRoot>$(MSBuildProjectDirectory)\Models\Consec</ConsecBundleRoot>
    <ConsecBundleComplete Condition="Exists('$(ConsecBundleRoot)\tokenizer.json') And Exists('$(ConsecBundleRoot)\model-manifest.json') And Exists('$(ConsecBundleRoot)\Cpu\consec-wngt-fp32.onnx') And Exists('$(ConsecBundleRoot)\Cpu\consec-wngt-fp32.onnx.data')">true</ConsecBundleComplete>
    <PublishExperimentalConsecModel Condition="'$(IncludeExperimentalConsecModel)' == 'true' Or '$(ConsecBundleComplete)' == 'true'">true</PublishExperimentalConsecModel>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AsteriaScale.RankerProtocol\AsteriaScale.RankerProtocol.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.1" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.70" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.4.1" />
    <PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.4.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Models\GlossEmbeddings\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Models\GlossBert\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Models\Consec\**\*"
             Condition="'$(PublishExperimentalConsecModel)' == 'true'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="ValidateExperimentalConsecBundle"
          BeforeTargets="PrepareForBuild"
          Condition="'$(IncludeExperimentalConsecModel)' == 'true' And '$(ConsecBundleComplete)' != 'true'">
    <Error Text="IncludeExperimentalConsecModel=true requires tokenizer.json, model-manifest.json, consec-wngt-fp32.onnx and consec-wngt-fp32.onnx.data under Models\Consec." />
  </Target>
</Project>
