    "neutral-vulgar": "a coarse reading competing with a plain one",
    "sexual-ordinary": "a sexual sense competing with an everyday one",
    "slang-colloquial": "slang, colloquial and archaic readings of ordinary words",
    "masked-euphemistic": "masked spellings such as f*ck and s**t as lookup candidates"
  },
