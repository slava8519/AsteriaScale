<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <ExpandPriResources>false</ExpandPriResources>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AsteriaScale\AsteriaScale.csproj" />
    <ProjectReference Include="..\..\src\AsteriaScale.RankerProtocol\AsteriaScale.RankerProtocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\AsteriaScale.RankerWorker\RankerSelectionLogic.cs"
             Link="RankerSelectionLogic.cs" />
  </ItemGroup>
</Project>
