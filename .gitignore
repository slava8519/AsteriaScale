# Build output
**/bin/
**/obj/
artifacts/
dist/
.vs/
*.user
*.suo

# macOS Finder metadata: a macOS clone writes these into every folder it opens.
.DS_Store

# GlossBERT model artifacts: 626 MB, individual files exceed GitHub's 100 MB
# limit. Distribute via Git LFS or GitHub Release assets; expected sizes and
# SHA-256 hashes are pinned in assets/Ranker/README.md and RankerEngine.cs.
src/AsteriaScale.RankerWorker/Models/GlossEmbeddings/*.onnx
src/AsteriaScale.RankerWorker/Models/GlossEmbeddings/*.vec
src/AsteriaScale.RankerWorker/Models/GlossBert/Cpu/*.onnx
src/AsteriaScale.RankerWorker/Models/GlossBert/Npu/*.onnx
src/AsteriaScale.RankerWorker/Models/GlossBert/Npu/*.bin

# Legacy local bundles of the removed GlossDeBERTa and SANDWiCH ranker
# profiles (up to ~1.1 GB each). Nothing builds, loads or publishes them any
# more, but an owner's machine may still hold them; keep them ignored so they
# never surface as untracked files.
src/AsteriaScale.RankerWorker/Models/GlossDeberta/
src/AsteriaScale.RankerWorker/Models/Sandwich/

# ConSeC is a non-commercial research-only ONNX bundle with 1.6 GB external
# tensor data. Install it locally with scripts/install-consec.ps1; never add
# its payload or generated manifest to ordinary git history. No trailing
# slash: a directory-only pattern does not match a symlink, so a symlinked
# Consec would surface as untracked and reach the working-tree export of
# tools/macos/check-windows-identity.sh (which refuses it).
src/AsteriaScale.RankerWorker/Models/Consec

# Dictionary source dumps (downloaded separately, multi-GB)
tools/dictionary-source/*.bz2
tools/dictionary-source/*.jsonl
tools/dictionary-source/*.jsonl.gz
tools/dictionary-source/*.tar.gz
tools/dictionary-source/*.tei
tools/dictionary-source/JMdict.gz
**/__pycache__/

# SwiftPM output of the macOS app package. tools/macos/test-swift.sh also
# keeps SwiftPM's cache, configuration and security state under .build, so
# nothing reaches ~/Library or ~/.swiftpm.
macos/AsteriaScale/.build/
macos/AsteriaScale/.swiftpm/
